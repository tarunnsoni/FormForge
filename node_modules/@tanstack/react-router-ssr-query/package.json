{
  "name": "@tanstack/react-router-ssr-query",
  "version": "1.167.3",
  "description": "Modern and scalable routing for React applications",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/router.git",
    "directory": "packages/react-router-ssr-query"
  },
  "homepage": "https://tanstack.com/router",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "react",
    "location",
    "router",
    "routing",
    "async",
    "async router",
    "typescript"
  ],
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@tanstack/router-ssr-query-core": "1.169.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@tanstack/react-query": ">=5.102.0",
    "vite": "*",
    "@tanstack/vite-config": "0.5.2",
    "vitest": "^4.1.4",
    "jsdom": "^25.0.1",
    "@eslint-react/eslint-plugin": "^1.26.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@arethetypeswrong/cli": "^0.18.4",
    "publint": "^0.3.16",
    "rimraf": "^6.1.2",
    "@tanstack/react-router": "1.170.37"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "@tanstack/query-core": ">=5.102.0",
    "@tanstack/react-router": ">=1.170.33",
    "@tanstack/react-query": ">=5.102.0"
  },
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage",
    "test:eslint": "eslint ./src",
    "test:types": "pnpm run \"/^test:types:ts[0-9]{2}$/\"",
    "test:types:ts56": "node ../../node_modules/typescript56/lib/tsc.js",
    "test:types:ts57": "node ../../node_modules/typescript57/lib/tsc.js",
    "test:types:ts58": "node ../../node_modules/typescript58/lib/tsc.js",
    "test:types:ts59": "node ../../node_modules/typescript59/lib/tsc.js",
    "test:types:ts60": "tsc6",
    "test:types:ts70": "tsc",
    "test:unit": "exit 0; vitest",
    "test:unit:dev": "pnpm run test:unit --watch",
    "test:build": "publint --strict && attw --ignore-rules no-resolution --pack .",
    "build": "vite build"
  }
}